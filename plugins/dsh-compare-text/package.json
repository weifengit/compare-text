{
  "name": "dsh-compare-text",
  "private": true,
  "description": "DSH 本地插件（仅服务端半侧）：DSH 启动时拉起 compare-text 的 serve.js（127.0.0.1:3180）并注册 /compare-text-meta；界面展示由 dsh-tokensave 项目中心发起，本插件不再注册任何入口",
  "version": "0.3.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "Apache-2.0"
}
