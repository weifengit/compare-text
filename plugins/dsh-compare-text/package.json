{
  "name": "dsh-compare-text",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 本地插件：把 compare-text 文本对比工具嵌入 DSH Web GUI（全屏浮层，仅本机 127.0.0.1，不对外发布）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "Apache-2.0"
}
